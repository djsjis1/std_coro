@PACKAGE_INIT@

if(@CORO_HAS_URING@ AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT TARGET uring::uring)
    find_path(CORO_URING_INCLUDE_DIR NAMES liburing.h)
    find_library(CORO_URING_LIBRARY NAMES uring)
    if(NOT CORO_URING_INCLUDE_DIR OR NOT CORO_URING_LIBRARY)
        set(coro_FOUND FALSE)
        set(coro_NOT_FOUND_MESSAGE "coro was built with io_uring support, but liburing was not found")
        return()
    endif()
    add_library(uring::uring UNKNOWN IMPORTED)
    set_target_properties(uring::uring PROPERTIES
        IMPORTED_LOCATION "${CORO_URING_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${CORO_URING_INCLUDE_DIR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/coroTargets.cmake")

check_required_components(coro)
