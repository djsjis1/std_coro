@PACKAGE_INIT@

# 依赖解析说明:
#   * Linux 的 io_uring 后端来自仓库内源码 thirdparty/liburing, 与本工程一起
#     构建为静态库并以 coro::uring 导出在 coroTargets.cmake 中 —— 消费端不需要、
#     也不会去查找系统预装的 liburing;
#   * 原生网络在 Windows 链接 ws2_32; 核心线程设施使用 Threads::Threads,
#     这些由导出目标的 INTERFACE_LINK_LIBRARIES 自动带入;
#   * 只需要协程核心 (Task/调度/同步/定时器) 的消费者应链接 coro::core,
#     它不携带任何原生 I/O 后端依赖; coro::coro 是其上的兼容入口。

# TLS: 在消费端重建 IMPORTED 目标。coroTargets.cmake 会清空 _IMPORT_PREFIX,
# 必须使用 configure_package_config_file(PATH_VARS ...) 生成的可重定位路径。
if(@CORO_HAS_TLS@)
    set_and_check(_coro_tls_include "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
    set_and_check(_coro_tls_crypto "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libcrypto.a")
    set_and_check(_coro_tls_ssl "@PACKAGE_CMAKE_INSTALL_LIBDIR@/libssl.a")
    if(NOT TARGET coro::openssl_crypto)
        add_library(coro::openssl_crypto STATIC IMPORTED)
        set_target_properties(coro::openssl_crypto PROPERTIES
            IMPORTED_LOCATION "${_coro_tls_crypto}"
            INTERFACE_INCLUDE_DIRECTORIES "${_coro_tls_include}")
        if(UNIX)
            set_property(TARGET coro::openssl_crypto APPEND PROPERTY INTERFACE_LINK_LIBRARIES dl)
        endif()
    endif()
    if(NOT TARGET coro::openssl_ssl)
        add_library(coro::openssl_ssl STATIC IMPORTED)
        set_target_properties(coro::openssl_ssl PROPERTIES
            IMPORTED_LOCATION "${_coro_tls_ssl}"
            INTERFACE_INCLUDE_DIRECTORIES "${_coro_tls_include}")
        set_property(TARGET coro::openssl_ssl APPEND PROPERTY INTERFACE_LINK_LIBRARIES coro::openssl_crypto)
    endif()
    unset(_coro_tls_include)
    unset(_coro_tls_crypto)
    unset(_coro_tls_ssl)
endif()

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/coroTargets.cmake")

# 源码树的历史名字仍可用; 安装包规范组件名为 coro::router。
if(NOT TARGET router::router)
    add_library(router::router ALIAS coro::router)
endif()

# 组件名即导出目标名: find_package(coro COMPONENTS core) 只校验所请求的目标是否存在。
# 未被请求的组件不会给消费者带来任何链接依赖 (由 target 级依赖保证), 因此这里不再为
# 组件单独 include 额外文件, 也不引入"按组件裁剪导出集"的二次机制。
foreach(_coro_comp IN LISTS coro_FIND_COMPONENTS)
    if(TARGET coro::${_coro_comp})
        set(coro_${_coro_comp}_FOUND TRUE)
    else()
        set(coro_${_coro_comp}_FOUND FALSE)
        set(coro_NOT_FOUND_MESSAGE
            "component '${_coro_comp}' is not provided by this installation; rebuild with the matching CORO_ENABLE_* option, or request only the components you need")
    endif()
endforeach()

check_required_components(coro)
